# Application
SERVER_PORT=8080
# PostgreSQL JDBC URL. Local default is provided by application-local.yml.
DB_URL=jdbc:postgresql://localhost:5432/cityguide
DB_USER=cityguide
DB_PASSWORD=cityguide

# Required HS256 secret: at least 32 bytes. Generate a random secret for each environment.
JWT_SECRET=
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P30D

# Login lockout
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_SECONDS=60

# Password reset
RESET_CODE_TTL_MINUTES=10
RESET_MAX_ATTEMPTS=5
DEV_RETURN_RESET_CODE=false

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*

# Local uploads
STORAGE_LOCAL_DIR=./uploads

# Optional bootstrap administrator; set both values
ADMIN_EMAIL=
ADMIN_PASSWORD=

# SMTP (required in prod)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
