# Copy values from Supabase Dashboard > Connect > Session pooler.
# Spring Boot does not load this file automatically; set variables in your shell or IDE.
SUPABASE_DB_HOST=your-project-pooler-host
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.your-project-ref
SUPABASE_DB_PASSWORD=replace-with-your-database-password
DB_POOL_SIZE=5
PORT=8080
