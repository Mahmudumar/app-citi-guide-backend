# Application server port
SERVER_PORT=8080
# PostgreSQL JDBC URL; include sslmode=require for Supabase production
DB_URL=jdbc:postgresql://localhost:5432/cityguide
# PostgreSQL database username
DB_USER=cityguide
# PostgreSQL database password
DB_PASSWORD=cityguide
# Required HS256 signing secret; at least 32 random bytes
JWT_SECRET=
# Access-token lifetime as an ISO-8601 duration
JWT_ACCESS_TTL=PT15M
# Refresh-token lifetime as an ISO-8601 duration
JWT_REFRESH_TTL=P30D
# Failed login attempts allowed before lockout
LOGIN_MAX_ATTEMPTS=5
# Login lockout duration in seconds
LOGIN_LOCK_SECONDS=60
# Password reset code lifetime in minutes
RESET_CODE_TTL_MINUTES=10
# Wrong reset codes allowed per code
RESET_MAX_ATTEMPTS=5
# Return reset codes in local profile responses only
DEV_RETURN_RESET_CODE=false
# Comma-separated allowed CORS origin patterns
CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*
# Local directory used for uploaded files
STORAGE_LOCAL_DIR=./uploads
# Optional administrator email; set with ADMIN_PASSWORD
ADMIN_EMAIL=
# Optional administrator password; set with ADMIN_EMAIL
ADMIN_PASSWORD=
# SMTP server hostname for the prod profile
MAIL_HOST=
# SMTP server port
MAIL_PORT=587
# SMTP username
MAIL_USERNAME=
# SMTP password
MAIL_PASSWORD=
# Sender email address for password reset messages
MAIL_FROM=
# Enable SMTP authentication
MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# Enable SMTP STARTTLS
MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
