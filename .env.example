# Local development profile. Render must use SPRING_PROFILES_ACTIVE=prod.
SPRING_PROFILES_ACTIVE=local
# Application server port (Render sets PORT automatically).
SERVER_PORT=8080
# PostgreSQL JDBC URL; include sslmode=require for Supabase production.
DB_URL=jdbc:postgresql://localhost:5432/cityguide
DB_USER=cityguide
DB_PASSWORD=cityguide
# Required HS256 signing secret; at least 32 random bytes.
JWT_SECRET=
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P30D
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_SECONDS=60
RESET_CODE_TTL_MINUTES=10
RESET_MAX_ATTEMPTS=5
DEV_RETURN_RESET_CODE=false
# Comma-separated allowed browser origins. Use exact production origins.
CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*
# Local directory for uploads; Render Blueprint uses /var/data/uploads.
STORAGE_LOCAL_DIR=./uploads
ADMIN_EMAIL=
ADMIN_PASSWORD=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
